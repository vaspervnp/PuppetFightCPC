10 MEMORY &1FFF
20 REM The REVIVE8BIT screen (art/revive8b.scr, its inks art/revive8b.txt),
30 REM until SPACE or ten seconds (TIME counts 300 a second).
40 ON ERROR GOTO 140
50 INK 0,0:INK 1,13:INK 2,26:INK 3,15:INK 4,25:INK 5,10:INK 6,3:INK 7,1
60 INK 8,11:INK 9,23:INK 10,6:INK 11,24:INK 12,20:INK 13,16:INK 14,12:INK 15,4
70 BORDER 0:MODE 0:LOAD"REVIVE8B.SCR",&C000
80 t=TIME+3000
90 IF INKEY(47)<>-1 THEN 110
100 IF TIME<t THEN 90
110 ON ERROR GOTO 0
120 LOAD"PFLOAD.BIN",&8000:CALL &8000
130 OUT &7F00,&C0:LOAD"PUPPET.BIN",&4000:CALL &4000
140 RESUME 110
