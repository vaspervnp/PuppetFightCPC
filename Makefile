# Puppet Fight CPC - build
#
#   make          build/pfspike.sna (Trump against Putin) and build/puppetfight.dsk
#                 (RUN"PUPPET: the select screen, then the characters chosen
#                 are loaded from their .PFC files)
#   make bench    run the spike on the headless 6128 and measure it
#   make run      open the snapshot in Caprice32
#
# DEMO=1 replaces the controls with a script (idle, swaying); the bench
# scenarios use it.
# CLOSE_UP=1 puts the fighters toe to toe, so both are rebuilt in one window.
# JUMP=1 makes them take turns to jump, then jump together (top at line 144).
# SHOTS=1 (with DEMO=1) sends projectiles across as well, for fighters
# whose character has one (CHAR_B=trump for two).
# SLACK=n starts every rebuild n*100 us late: the margin test (SLACK=15
# must stay clean in the jump scenario).
# QUICKWIN=1 makes player 1 win every match at once (a test disc: the
# ladder runs by itself).
# CPU=n puts the computer in charge of fighter A (1), B (2) or both (3), at
# LEVEL=0 (easy), 1 (normal) or 2 (hard); +16 is training (CPU=17
# CHAR_B=dummy: the computer against the training dummy); on the disc the
# select screen chooses.
# TRAINER is training's fighter B: on the disc, not on the select screen's
# roster.
#
#   make bench-all   every scenario the 25 fps rule has to hold in
#   make bench-ai    the computer against itself (CPU=3 LEVEL=2)

RASM   ?= rasm
PYTHON ?= python3
CLOSE_UP ?= 0
JUMP ?= 0
DEMO ?= 0
SLACK ?= 0
SHOTS ?= 0
CPU ?= 0
LEVEL ?= 1
QUICKWIN ?= 0
CACHE_SLOT := $(shell awk '$$1=="CACHE_SLOT"{print $$3}' src/config.asm)
BUILD  := build

CHARS := trump putin kim xi musk zelensky
BOSS := bremmer
TRAINER := dummy
CHAR_A ?= trump
CHAR_B ?= putin
roster_index = $(shell echo $(CHARS) $(BOSS) $(TRAINER) | tr ' ' '\n' | grep -nx $(1) | awk -F: '{print $$1-1}')
RASMFLAGS := -DCLOSE_UP=$(CLOSE_UP) -DJUMP=$(JUMP) -DSLACK=$(SLACK) -DDEMO=$(DEMO) -DSHOTS=$(SHOTS) \
             -DCPU=$(CPU) -DLEVEL=$(LEVEL) -DQUICKWIN=$(QUICKWIN) \
             -DCHAR_A_I=$(call roster_index,$(CHAR_A)) -DCHAR_B_I=$(call roster_index,$(CHAR_B))
STAGES := whitehouse kremlin pyongyang beijing starbase kyiv theatre
STAGE ?= $(shell $(PYTHON) -c "import json; print(json.load(open('art/sprites/$(CHAR_B)_pfc.json'))['stage'])")
stage_file = $(BUILD)/stages/$(shell $(PYTHON) -c "import json; print(json.load(open('art/stages/$(1).json'))['name'])").STG
STG := $(foreach s,$(STAGES),$(call stage_file,$(s)))
GEN := src/gen/$(CHAR_A)_a_bank0.asm src/gen/$(CHAR_A)_a_bank1.asm \
       src/gen/$(CHAR_B)_b_bank0.asm src/gen/$(CHAR_B)_b_bank1.asm src/gen/chars.asm \
       src/gen/stage.asm src/gen/music.asm src/gen/diskmap.asm
SRC := $(filter-out src/loader.asm,$(wildcard src/*.asm)) $(GEN)
PFC := $(foreach c,$(CHARS) $(BOSS) $(TRAINER),$(BUILD)/pfc/$(shell echo $(c) | tr a-z A-Z).PFC)

all: $(BUILD)/pfspike.sna

$(BUILD):
	mkdir -p $@

src/gen/tables.asm: tools/sprite_codegen.py
	$(PYTHON) tools/sprite_codegen.py tables

# A character's two bank images come out of one run. Draws are compiled at
# run time (src/jit.asm); --slot checks every frame fits a cache slot.
# The snapshot's fighters: CHAR_A, and CHAR_B with its own colours in pens
# 10-13 (--side b). chars.asm includes them, rewritten only when they change.
src/gen/%_a_bank0.asm src/gen/%_a_bank1.asm &: tools/sprite_codegen.py tools/cpc_palette.py \
        src/config.asm art/sprites/%.json art/sprites/%_hits.json art/sprites/%_pfc.json \
        $(wildcard art/sprites/*/*.png)
	$(PYTHON) tools/sprite_codegen.py character $* --slot $(CACHE_SLOT) --side a

src/gen/%_b_bank0.asm src/gen/%_b_bank1.asm &: tools/sprite_codegen.py tools/cpc_palette.py \
        src/config.asm art/sprites/%.json art/sprites/%_hits.json art/sprites/%_pfc.json \
        $(wildcard art/sprites/*/*.png)
	$(PYTHON) tools/sprite_codegen.py character $* --slot $(CACHE_SLOT) --side b

src/gen/chars.asm: FORCE
	printf ';; generated by the Makefile: CHAR_A=%s CHAR_B=%s\nBANK 4\n    include "%s_a_bank0.asm"\nBANK 5\n    include "%s_a_bank1.asm"\nBANK 6\n    include "%s_b_bank0.asm"\nBANK 7\n    include "%s_b_bank1.asm"\n' \
	    $(CHAR_A) $(CHAR_B) $(CHAR_A) $(CHAR_A) $(CHAR_B) $(CHAR_B) > $@.new
	cmp -s $@.new $@ && rm $@.new || mv $@.new $@

# Stages: drawn by tools/stage_art.py, packed for the disc. The snapshot
# has STAGE's (fighter B's home stage by default) where the loader puts it.
art/stages/%.png: tools/stage_art.py tools/cpc_palette.py art/stages/%.json
	$(PYTHON) tools/stage_art.py $*

$(BUILD)/stages/%.STG: tools/stage_pack.py tools/stage_art.py art/stages/*.png art/stages/*.json | $(BUILD)
	for s in $(STAGES); do $(PYTHON) tools/stage_pack.py $$s; done

src/gen/stage.asm: FORCE $(call stage_file,$(STAGE))
	printf ';; generated by the Makefile: STAGE=%s\n    incbin "../../$(call stage_file,$(STAGE))"\n' $(STAGE) > $@.new
	cmp -s $@.new $@ && rm $@.new || mv $@.new $@

# The music and sound effects (src/sound.asm).
src/gen/music.asm: tools/music.py
	$(PYTHON) tools/music.py

# The title screen, which the loader shows first, and the select screen's
# background and fighters.
$(BUILD)/TITLE.SCR $(BUILD)/SELECT.SCR $(BUILD)/FIGHTERS.BIN &: tools/title_art.py tools/stage_pack.py tools/sprite_codegen.py art/title.json \
        art/sprites/*.json $(wildcard art/sprites/*/*.png) | $(BUILD)
	CHARS="$(CHARS) $(TRAINER)" $(PYTHON) tools/title_art.py

# Character files for the disc, made for fighter B's pens (the loader moves
# fighter A's), and the list of them the select screen reads.
$(BUILD)/pfc/%.PFC: tools/sprite_codegen.py tools/cpc_palette.py src/config.asm \
        art/sprites/*.json art/stages/*.json $(wildcard art/sprites/*/*.png) | $(BUILD)
	$(PYTHON) tools/sprite_codegen.py pfc $(shell echo $* | tr A-Z a-z) --slot $(CACHE_SLOT)

$(BUILD)/pfc/ROSTER.TXT: Makefile | $(BUILD)
	mkdir -p $(BUILD)/pfc
	printf '%s\r\n' $(shell echo $(CHARS) | tr a-z A-Z) > $@

# Where the engine finds the character files and stages on the disc
# (tools/make_dsk.py): they go first, so it doesn't depend on the engine.
src/gen/diskmap.asm: tools/make_dsk.py $(PFC) $(STG) $(BUILD)/pfc/ROSTER.TXT
	CHARS="$(CHARS)" BOSS="$(BOSS)" TRAINER="$(TRAINER)" $(PYTHON) tools/make_dsk.py map

src/gen/remap.asm: tools/sprite_codegen.py tools/cpc_palette.py
	$(PYTHON) tools/sprite_codegen.py remap

$(BUILD)/PFLOAD.BIN: src/loader.asm src/gen/remap.asm | $(BUILD)
	cd src && $(RASM) loader.asm -o ../$(BUILD)/pfload >/dev/null

# One rasm pass writes the snapshot, the symbols and (via SAVE) the engine;
# then the disc, an extended DSK with everything (tools/make_dsk.py).
$(BUILD)/pfspike.sna: $(SRC) $(BUILD)/PFLOAD.BIN $(PFC) $(STG) $(BUILD)/TITLE.SCR $(BUILD)/SELECT.SCR $(BUILD)/FIGHTERS.BIN $(BUILD)/pfc/ROSTER.TXT FORCE | $(BUILD)
	cd src && $(RASM) main.asm -oi ../$@ -s -sl -sq -os ../$(BUILD)/pfspike.sym -v2 $(RASMFLAGS)
	CHARS="$(CHARS)" BOSS="$(BOSS)" TRAINER="$(TRAINER)" $(PYTHON) tools/make_dsk.py write $(BUILD)/puppetfight.dsk

bench: $(BUILD)/pfspike.sna
	$(PYTHON) tools/spike_bench.py

# Apart (two windows), and toe to toe with jumps (one shared window, banded).
# Overlaps need compiled draws for both fighters: see GAME_PLAN 3.2b.
bench-all:
	$(MAKE) --no-print-directory bench DEMO=1
	$(MAKE) --no-print-directory bench DEMO=1 CLOSE_UP=1
	$(MAKE) --no-print-directory bench DEMO=1 CLOSE_UP=1 JUMP=1
	$(MAKE) --no-print-directory bench DEMO=1 CLOSE_UP=1 JUMP=1 SHOTS=1 CHAR_B=trump

run: $(BUILD)/pfspike.sna
	caprice32 $(abspath $(BUILD)/pfspike.sna)

# The manuals, English and Greek, as PDFs (needs: pip install markdown
# fpdf2, and the DejaVu fonts). Screenshots in docs/img.
manual: manual.pdf manual_gr.pdf

manual.pdf manual_gr.pdf: %.pdf: %.md tools/mkmanual.py $(wildcard docs/img/*.png)
	$(PYTHON) tools/mkmanual.py $< $@

# The release: the disc and the manuals in build/PuppetFight.zip.
release: $(BUILD)/pfspike.sna manual.pdf manual_gr.pdf
	rm -rf $(BUILD)/release $(BUILD)/PuppetFight.zip
	mkdir -p $(BUILD)/release
	cp $(BUILD)/puppetfight.dsk $(BUILD)/release/PuppetFight.dsk
	cp manual.pdf $(BUILD)/release/PuppetFight-manual.pdf
	cp manual_gr.pdf $(BUILD)/release/PuppetFight-manual-gr.pdf
	cd $(BUILD)/release && zip -q ../PuppetFight.zip *
	@echo "$(BUILD)/PuppetFight.zip"

clean:
	rm -rf $(BUILD)

FORCE:
.PHONY: all bench bench-all bench-play bench-fight run clean manual release FORCE

# The game with scripted controls: walk in, jump over, attacks. Close combat
# needs the runtime compiler (only idle frames have compiled draws), so this
# reports caught lines rather than gating on them.
PLAY_KEYS := RIGHT@2-26,a@2-20,SPACE@30,z@34,x@40,DOWN@46-56,x@48,DOWN@60-64,SPACE@62,UP@70-71,RIGHT@70-80,LEFT@86-90,x@88
bench-play:
	$(MAKE) --no-print-directory $(BUILD)/pfspike.sna
	$(PYTHON) tools/spike_bench.py --keys $(PLAY_KEYS) --shots 20,31,50,76,90 || true

# Combat: Trump lands a punch, Putin walks in and lands one, Trump blocks a
# kick, Trump lands another. Ends Trump 36, Putin 32.
FIGHT_KEYS := RIGHT@2-26,a@2-26,SPACE@30,a@40-42,z@44,RIGHT@52-55,LEFT@57-68,x@59,RIGHT@70-73,SPACE@75,a@80-83,x@86
# The computer against itself, at its hardest: the logic at its busiest.
bench-ai:
	$(MAKE) --no-print-directory $(BUILD)/pfspike.sna CPU=3 LEVEL=2
	$(PYTHON) tools/spike_bench.py --shots 30,60,90 || true

bench-fight:
	$(MAKE) --no-print-directory $(BUILD)/pfspike.sna
	$(PYTHON) tools/spike_bench.py --keys $(FIGHT_KEYS) --shots 34,47,62,78,90 || true
